{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "references": [
    { "path": "./tsconfig.app.json" }
  ],
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts"]
}
